<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ltdz.taskflow.mapper.UserMapper">

    <select id="selectByPassword" resultType="UserPo">
        SELECT `id`, `name`, `title`, `index_txt`, `password`
        FROM `user`
        WHERE `password` = #{password}
        LIMIT 1
    </select>

    <select id="selectById" resultType="UserPo">
        SELECT `id`, `name`, `title`, `index_txt`
        FROM `user`
        WHERE `id` = #{id}
    </select>

</mapper>
